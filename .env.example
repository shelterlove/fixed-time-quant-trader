# Binance USD-M Futures TESTNET credentials only. Never commit your real .env.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# A deliberate opt-in is required before any testnet order is sent. Keep false
# for the first deployment; do not disable while positions need programmatic exits.
TRADING_ENABLED=false

# This path is persisted by Docker through ./runtime. Do not commit it.
DATABASE_PATH=runtime/testnet.sqlite3

# Optional override. The frozen runtime default is 5 seconds.
ACCOUNT_POLL_SECONDS=5
